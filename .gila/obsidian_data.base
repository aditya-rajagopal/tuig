formulas:
  "": ""
views:
  - type: table
    name: TODO
    filters:
      and:
        - file.hasProperty("title")
        - status != "done"
    order:
      - file.name
      - title
      - priority_value
      - priority
      - tags
      - status
      - created
      - waiting_on
    sort:
      - property: priority
        direction: ASC
      - property: tags
        direction: DESC
      - property: status
        direction: DESC
      - property: title
        direction: DESC
      - property: created
        direction: DESC
      - property: formula.
        direction: ASC
      - property: priority_value
        direction: ASC
    columnSize:
      note.title: 651
      note.priority_value: 59
      note.priority: 99
      note.tags: 148
      note.status: 71
      note.created: 178
  - type: table
    name: Done Tasks
    filters:
      and:
        - file.hasProperty("status")
        - status == "done"
    order:
      - file.name
      - title
      - tags
      - completed
    columnSize:
      note.title: 424
      note.tags: 146
      note.completed: 212
